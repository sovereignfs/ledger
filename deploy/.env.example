# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Ledger reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
LEDGER_URL=http://localhost:3003
# The port on this machine that a reverse proxy sends to (the container listens on 3003, the port in sovereign.manifest.json).
# LEDGER_PORT=3003

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
LEDGER_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
LEDGER_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
LEDGER_AUTH_SIGNUP=closed

# --- The instance key ----------------------------------------------------------------------------------------------
# 32 random bytes that seal any credential the app keeps for another service. Make it once and keep it with your secrets, apart from the
# database backups.   openssl rand -base64 32
LEDGER_ENCRYPTION_KEY=

# --- Exchange rates ------------------------------------------------------------------------------------------------
# One request goes to Frankfurter, for the latest rates against USD, naming no currency. `off` stops the fetch; amounts in other currencies are then reported as not included.
# LEDGER_FX=on

# --- Mail (optional) -----------------------------------------------------------------------------------------------
# With a host, an address is verified, a password is reset by a link, and the monthly recap is emailed when core is not doing it.
# LEDGER_SMTP_HOST=
# LEDGER_SMTP_PORT=587
# LEDGER_SMTP_USER=
# LEDGER_SMTP_PASSWORD=
# LEDGER_SMTP_FROM=

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
