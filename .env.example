# Every setting Ledger reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Ledger gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
LEDGER_URL=http://localhost:3003

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Exchange rates, recurring entries and the monthly recap run inside the web process. When several processes share one database, set `off` on
# all but one.
# LEDGER_WORKER=on

# --- Exchange rates --------------------------------------------------------------------------------------------------------------------
# `off` stops the fetch (amounts in other currencies are then reported as not included). One request for the latest rates against USD goes out, naming no currency and nothing of a book.
# LEDGER_FX=on
# Where Frankfurter is, for a mirror. https, or http for localhost alone. Default https://api.frankfurter.dev.
# LEDGER_FX_URL=

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password, passkeys and two-factor.
LEDGER_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
LEDGER_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
LEDGER_AUTH_SIGNUP=closed
# The shortest password, 8 to 128. Default 10.
# LEDGER_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together, and either way of signing in, or both, can be on). LEDGER_CORE_URL is the instance's core, its OIDC
# issuer: its address with no path and no trailing slash, https (http for localhost). Register the client at core with the redirect address
# <LEDGER_URL>/api/auth/callback/sovereign. Needs LEDGER_URL and LEDGER_AUTH_SECRET as local sign-in does; LEDGER_AUTH_LOCAL may then be 0.
# LEDGER_CORE_URL=https://sovereign.example.com
# LEDGER_CORE_CLIENT_ID=
# LEDGER_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# LEDGER_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# LEDGER_SQLD_URL=http://sqld:8080
# LEDGER_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# LEDGER_SQLITE_URL=file:/data/ledger.db
# postgres: the address, a root certificate for TLS, and the most connections the app may hold (2 or more).
# LEDGER_POSTGRES_URL=postgres://user:password@localhost:5432/ledger
# PGSSLROOTCERT=
# LEDGER_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# LEDGER_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# LEDGER_MIGRATIONS_DIR=

# --- Mail (optional) ---------------------------------------------------------------------------------------------------------------------
# With a host, an address is verified before first sign-in, a forgotten password is reset by a link, and the monthly recap is emailed when core
# is not doing it. Without one, none of that is offered.
# LEDGER_SMTP_HOST=
# LEDGER_SMTP_PORT=587
# LEDGER_SMTP_USER=
# LEDGER_SMTP_PASSWORD=
# The sender: `Ledger <ledger@example.com>`. Required with a host.
# LEDGER_SMTP_FROM=

# --- The instance key --------------------------------------------------------------------------------------------------------------------
# 32 random bytes that seal any credential the app keeps for another service. Make it once and keep it with your secrets, apart from the database
# backups.   openssl rand -base64 32
LEDGER_ENCRYPTION_KEY=
# When changing the key, put the old one here until the server has started once with both.
# LEDGER_ENCRYPTION_KEY_PREVIOUS=
