{
  "name": "@sovereignfs/ledger",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/ledger.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "description": "Ledger: your budget, your accounts and your net worth, in every currency you use. Runs on its own or on a Sovereign instance.",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "PORT=${PORT:-3003} node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:generate": "node scripts/db-generate.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "boot-check": "node scripts/boot-check.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sovereignfs/config": "0.1.0",
    "@sovereignfs/ui": "0.92.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
